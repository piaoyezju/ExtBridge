<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- Shizuku manager visibility (Android 11+ package filtering) -->
        <package android:name="moe.shizuku.manager" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="ExtBridge"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="ExtBridge"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.tablet"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:label="ExtBridge 触摸板"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.tablet"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode" />

        <activity
            android:name=".SideControlActivity"
            android:exported="false"
            android:label="ExtBridge 副屏直控"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.tablet"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />

        <activity
            android:name=".SideMouseCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:resizeableActivity="false"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:taskAffinity="com.extbridge.helper.capture"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="ExtBridge 桌面"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.extdesktop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />

        <service
            android:name=".BridgeService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="External display overlay controller and cursor presenter" />
        </service>

        <service
            android:name=".NavAssistService"
            android:exported="true"
            android:label="ExtBridge 平板辅助手势"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nav_assist_config" />
        </service>

        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.INJECT_EVENTS">
            <intent-filter>
                <action android:name="com.extbridge.helper.BINDER_PUSH" />
                <action android:name="com.extbridge.helper.TOGGLE_INPUT" />
                <action android:name="com.extbridge.helper.STATE_SYNC" />
                <action android:name="com.extbridge.helper.REBUILD" />
                <action android:name="com.extbridge.helper.LAUNCH_EXT_HOME" />
                <action android:name="com.extbridge.helper.TOGGLE_MIRROR" />
                <action android:name="com.extbridge.helper.SET_MIRROR_SIDE_MODE" />
                <action android:name="com.extbridge.helper.SPLIT_ACTION" />
                <action android:name="com.extbridge.helper.SET_ROTATION" />
                <action android:name="com.extbridge.helper.SET_DOCK_AUTO_HIDE" />
                <action android:name="com.extbridge.helper.EXIT_ALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ControlReceiver$Internal"
            android:exported="false" />

        <provider
            android:name=".BridgeProvider"
            android:authorities="com.extbridge.helper.provider"
            android:exported="true" />

        <!-- Shizuku API: receives the service binder from the Shizuku manager (protected by
             INTERACT_ACROSS_USERS_FULL so normal apps cannot read it). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
